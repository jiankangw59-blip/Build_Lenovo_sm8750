+static void crystal_sddc_resident_hash_error_test(struct kunit *test)
+{
+	struct crystal_sddc_test_ctx *ctx = test->priv;
+	struct crystal_sddc_slot_state *state = NULL;
+	struct crystal_sddc_ref ref = {
+		.sddc = &ctx->sddc,
+		.cookie = { .id = 41, .generation = 23 },
+		.size = PAGE_SIZE,
+		.prio = ZRAM_PRIMARY_COMP,
+	};
+	struct zs_pool *pool;
+	struct page *page = NULL;
+	unsigned long handle = 0;
+	u32 expected_hash;
+	void *data;
+	int ret;
+
+	/* The test owns every byte; it neither creates nor modifies a zram device. */
+	pool = zs_create_pool("sddc-kunit-integrity");
+	if (!pool) {
+		KUNIT_FAIL(test, "cannot create private zsmalloc pool");
+		return;
+	}
+	ctx->zram.mem_pool = pool;
+	handle = zs_malloc(pool, PAGE_SIZE, GFP_KERNEL);
+	if (!handle || IS_ERR_VALUE(handle)) {
+		KUNIT_FAIL(test, "cannot allocate private reference object");
+		handle = 0;
+		goto out;
+	}
+	page = alloc_page(GFP_KERNEL);
+	if (!page) {
+		KUNIT_FAIL(test, "cannot allocate private read destination");
+		goto out;
+	}
+	data = zs_map_object(pool, handle, ZS_MM_WO);
+	memset(data, 0xa5, PAGE_SIZE);
+	expected_hash = crystal_sddc_page_hash(data);
+	zs_unmap_object(pool, handle);
+
+	state = crystal_sddc_test_install_state(ctx, 0, CRYSTAL_SDDC_REF);
+	if (!state) {
+		KUNIT_FAIL(test, "cannot install private reference state");
+		goto out;
+	}
+	ref.handle = handle;
+	/* Keep a test owner so read pins never schedule asynchronous ref freeing. */
+	refcount_set(&ref.refs, 2);
+	state->ref = ref.cookie;
+	state->ref_obj = &ref;
+	state->ref_size = PAGE_SIZE;
+	state->target_size = PAGE_SIZE;
+	state->page_hash = expected_hash;
+	ret = crystal_sddc_read_page(&ctx->zram, page, 0);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+
+	/* Corrupt only the captured expectation, preserving the data and length. */
+	state->page_hash = expected_hash ^ 1U;
+	if (!state->page_hash)
+		state->page_hash = 2U;
+	ret = crystal_sddc_read_page(&ctx->zram, page, 0);
+	KUNIT_EXPECT_EQ(test, ret, -EIO);
+	crystal_sddc_slot_lock(&ctx->zram, 0);
+	ret = crystal_sddc_read_page_locked(&ctx->zram, page, 0);
+	KUNIT_EXPECT_EQ(test, ret, -EIO);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&ctx->sddc.stats.integrity_checks),
+			(s64)3);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&ctx->sddc.stats.integrity_failures),
+			(s64)2);
+	KUNIT_EXPECT_EQ(test, atomic64_read(&ctx->sddc.stats.decode_failures),
+			(s64)2);
+	KUNIT_EXPECT_EQ(test, refcount_read(&ref.refs), 2U);
+	KUNIT_EXPECT_EQ(test, atomic_read(&ctx->sddc.active_ops), 0);
+
+out:
+	if (state) {
+		xa_erase(&ctx->sddc.slot_states, 0);
+		state->ref_obj = NULL;
+		kfree(state);
+	}
+	if (page)
+		__free_page(page);
+	if (handle)
+		zs_free(pool, handle);
+	zs_destroy_pool(pool);
+	ctx->zram.mem_pool = NULL;
+}
