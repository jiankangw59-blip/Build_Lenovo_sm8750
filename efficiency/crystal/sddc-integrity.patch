+static void crystal_sddc_delta_proof_identity_test(struct kunit *test)
+{
+	u8 original[64];
+	u8 proof[sizeof(original)];
+	unsigned int i;
+
+	for (i = 0; i < sizeof(original); i++)
+		original[i] = (u8)(i * 17U + 3U);
+	memcpy(proof, original, sizeof(proof));
+	KUNIT_EXPECT_TRUE(test, crystal_sddc_delta_proof_valid(0,
+			sizeof(proof), proof, original, sizeof(original)));
+	/* Equal-length corruption at the head, middle and tail must be rejected. */
+	for (i = 0; i < 3; i++) {
+		unsigned int offset = i == 0 ? 0 : i == 1 ? 32 : 63;
+
+		proof[offset] ^= 1;
+		KUNIT_EXPECT_FALSE(test, crystal_sddc_delta_proof_valid(0,
+				sizeof(proof), proof, original, sizeof(original)));
+		proof[offset] ^= 1;
+	}
+	KUNIT_EXPECT_FALSE(test, crystal_sddc_delta_proof_valid(-EIO,
+			sizeof(proof), proof, original, sizeof(original)));
+	KUNIT_EXPECT_FALSE(test, crystal_sddc_delta_proof_valid(0,
+			sizeof(proof) - 1, proof, original, sizeof(original)));
+	KUNIT_EXPECT_FALSE(test, crystal_sddc_delta_proof_valid(0,
+			sizeof(proof), NULL, original, sizeof(original)));
+}
