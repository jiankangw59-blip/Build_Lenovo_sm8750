+static bool crystal_sddc_delta_proof_valid(int ret, unsigned int proof_size,
+		const void *proof, const void *original, u32 original_size)
+{
+	if (ret || !proof || !original || !original_size ||
+	    original_size > PAGE_SIZE || proof_size != original_size)
+		return false;
+
+	/* A successful decoder and matching length do not prove byte identity. */
+	return !memcmp(proof, original, original_size);
+}
