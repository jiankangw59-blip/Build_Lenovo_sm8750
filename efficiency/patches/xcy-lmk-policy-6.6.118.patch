diff --git a/include/uapi/linux/xcy_lmk.h b/include/uapi/linux/xcy_lmk.h
new file mode 100644
index 0000000..0d3c2d6
--- /dev/null
+++ b/include/uapi/linux/xcy_lmk.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_XCY_LMK_H
+#define _UAPI_LINUX_XCY_LMK_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define XCY_LMK_ABI_VERSION 1
+#define XCY_LMK_MAX_ENTRIES 512
+#define XCY_LMK_NO_SELECTION ((__u32)~0U)
+
+#define XCY_LMK_RANK_URGENT (1U << 0)
+#define XCY_LMK_CANDIDATE_ELIGIBLE (1U << 0)
+#define XCY_LMK_CANDIDATE_RECENT (1U << 1)
+
+struct xcy_lmk_batch {
+	__aligned_u64 entries;
+	__u32 version;
+	__u32 count;
+	__u32 flags;
+	__u32 selected;
+};
+
+/* Eligibility and PSS are supplied after the Android-level policy checks. */
+struct xcy_lmk_candidate {
+	__aligned_u64 background_age_ms;
+	__u32 pss_kib;
+	__u32 flags;
+};
+
+/* pid, uid and start_ticks identify a process. The rest is output.
+ * start_ticks is the Linux /proc/PID/stat field 22 in the caller's time namespace.
+ * RSS and swap are separate kernel counters and are not PSS.
+ */
+struct xcy_lmk_task {
+	__u32 pid;
+	__u32 uid;
+	__aligned_u64 start_ticks;
+	__aligned_u64 rss_kib;
+	__aligned_u64 swap_kib;
+	__s32 oom_score_adj;
+	__s32 status;
+};
+
+#define XCY_LMK_READ_TASKS _IOWR('X', 0x80, struct xcy_lmk_batch)
+#define XCY_LMK_RANK _IOWR('X', 0x81, struct xcy_lmk_batch)
+
+#endif
diff --git a/mm/Kconfig b/mm/Kconfig
index 8080830..96839d1 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1361,6 +1361,16 @@ config MEMFD_ASHMEM_SHIM
 
 	  Unless you are running Android, say N.
 
+config XCY_LMK_POLICY
+	bool "XiaoCaiYe low-memory candidate policy"
+	depends on MMU
+	help
+	  Expose an on-demand interface for selecting a low-memory candidate
+	  from Android-verified input and reading batched process counters.
+	  This interface does not issue signals or run a background worker.
+	  Android-side policy remains responsible for foreground, playback
+	  and package allowlist checks before acting on the selected index.
+
 source "mm/damon/Kconfig"
 
 endmenu
