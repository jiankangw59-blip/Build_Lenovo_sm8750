From d29ab201ef2620d31faa29ddbf1269c4dfeff738 Mon Sep 17 00:00:00 2001
From: Oleksandr Natalenko <oleksandr@natalenko.name>
Date: Tue, 18 Mar 2025 09:47:46 +0100
Subject: [PATCH] tcp: bbr3: silence -Wconstant-logical-operand

The ecn_thresh and ecn_factor parameters are constants in the public BBRv3
version, so evaluating them as boolean operands triggers Clang's
-Wconstant-logical-operand warning.

Convert the relevant values to boolean explicitly.  Keep the conditions in
place because the internal BBRv3 version uses configurable values there.

Link: https://lore.kernel.org/lkml/4616579.LvFx2qVVIh@natalenko.name/T/#u
Link: https://groups.google.com/g/bbr-dev/c/4vwZGw0nxdQ/m/fWt9xmbzAwAJ
Closes: https://codeberg.org/pf-kernel/linux/issues/11
Change-Id: I5bc6743bc8bc9b408a202df33b1d7cc0c1b129e6
Signed-off-by: Oleksandr Natalenko <oleksandr@natalenko.name>
(cherry picked from commit 52e0c91bde84f22f47e080121ebd5c8d5edbf811)
---
 net/ipv4/tcp_bbr.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/net/ipv4/tcp_bbr.c b/net/ipv4/tcp_bbr.c
index 2eabc13e3353..0a15a7d66d02 100644
--- a/net/ipv4/tcp_bbr.c
+++ b/net/ipv4/tcp_bbr.c
@@ -1102,6 +1102,7 @@ static int bbr_update_ecn_alpha(struct sock *sk)
 
 	/* See if we should use ECN sender logic for this connection. */
 	if (!bbr->ecn_eligible && bbr_can_use_ecn(sk) &&
+	    !!bbr_param(sk, ecn_factor) &&
 	    (bbr->min_rtt_us <= bbr_ecn_max_rtt_us ||
 	     !bbr_ecn_max_rtt_us))
 		bbr->ecn_eligible = 1;
@@ -1208,7 +1209,7 @@ static bool bbr_is_inflight_too_high(const struct sock *sk,
 	}
 
 	if (rs->delivered_ce > 0 && rs->delivered > 0 &&
-	    bbr->ecn_eligible) {
+	    bbr->ecn_eligible && !!bbr_param(sk, ecn_thresh)) {
 		ecn_thresh = (u64)rs->delivered * bbr_param(sk, ecn_thresh) >>
 				BBR_SCALE;
 		if (rs->delivered_ce > ecn_thresh) {
@@ -1406,7 +1407,7 @@ static void bbr_adapt_lower_bounds(struct sock *sk,
 		return;
 
 	/* ECN response. */
-	if (bbr->ecn_in_round) {
+	if (bbr->ecn_in_round && !!bbr_param(sk, ecn_factor)) {
 		bbr_init_lower_bounds(sk, false);
 		bbr_ecn_lower_bounds(sk, &ecn_inflight_lo);
 	}
