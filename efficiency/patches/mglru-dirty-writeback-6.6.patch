From: Local integration <local@localhost>
Subject: [PATCH] mm/mglru: backport per-batch dirty/writeback handling to 6.6

Based on Kairui Song e36ef45be91813f7aca451e4264b7dcf56aabfd2.
Carry the existing isolated-page count through private 6.6 helpers, preserving
Android vendor hooks and avoiding an additional list traversal. No public
structure changes.

--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -5181,7 +5181,7 @@
 EXPORT_SYMBOL_GPL(isolate_folio);
 
 static int scan_folios(struct lruvec *lruvec, struct scan_control *sc,
-		       int type, int tier, struct list_head *list)
+		       int type, int tier, struct list_head *list, int *nr_isolated)
 {
 	int i;
 	int gen;
@@ -5195,6 +5195,7 @@
 	struct mem_cgroup *memcg = lruvec_memcg(lruvec);
 
 	VM_WARN_ON_ONCE(!list_empty(list));
+	*nr_isolated = 0;
 
 	if (get_nr_gens(lruvec, type) == MIN_NR_GENS)
 		return 0;
@@ -5253,8 +5254,7 @@
 	trace_mm_vmscan_lru_isolate(sc->reclaim_idx, sc->order, MAX_LRU_BATCH,
 				scanned, skipped, isolated,
 				type ? LRU_INACTIVE_FILE : LRU_INACTIVE_ANON);
-	if (type == LRU_GEN_FILE)
-		sc->nr.file_taken += isolated;
+	*nr_isolated = isolated;
 	/*
 	 * There might not be eligible folios due to reclaim_idx. Check the
 	 * remaining to prevent livelock if it's not making progress.
@@ -5311,7 +5311,7 @@
 }
 
 static int isolate_folios(struct lruvec *lruvec, struct scan_control *sc, int swappiness,
-			  int *type_scanned, struct list_head *list)
+			  int *type_scanned, struct list_head *list, int *nr_isolated)
 {
 	int i;
 	int type;
@@ -5339,7 +5339,7 @@
 		if (tier < 0)
 			tier = get_tier_idx(lruvec, type);
 
-		scanned = scan_folios(lruvec, sc, type, tier, list);
+		scanned = scan_folios(lruvec, sc, type, tier, list, nr_isolated);
 		if (scanned)
 			break;
 
@@ -5357,6 +5357,7 @@
 	int type;
 	int scanned;
 	int reclaimed;
+	int isolated = 0;
 	LIST_HEAD(list);
 	LIST_HEAD(clean);
 	struct folio *folio;
@@ -5370,7 +5371,7 @@
 
 	spin_lock_irq(&lruvec->lru_lock);
 
-	scanned = isolate_folios(lruvec, sc, swappiness, &type, &list);
+	scanned = isolate_folios(lruvec, sc, swappiness, &type, &list, &isolated);
 
 	scanned += try_to_inc_min_seq(lruvec, swappiness);
 
@@ -5383,11 +5384,17 @@
 		return scanned;
 retry:
 	reclaimed = shrink_folio_list(&list, pgdat, sc, &stat, false);
-	sc->nr.unqueued_dirty += stat.nr_unqueued_dirty;
 	sc->nr_reclaimed += reclaimed;
 	trace_mm_vmscan_lru_shrink_inactive(pgdat->node_id,
 			scanned, reclaimed, &stat, sc->priority,
 			type ? LRU_INACTIVE_FILE : LRU_INACTIVE_ANON);
+
+	/* Wake the flusher per isolated batch instead of after the full scan. */
+	if (stat.nr_unqueued_dirty == isolated) {
+		wakeup_flusher_threads(WB_REASON_VMSCAN);
+		if (!writeback_throttling_sane(sc))
+			reclaim_throttle(pgdat, VMSCAN_THROTTLE_WRITEBACK);
+	}
 
 	list_for_each_entry_safe_reverse(folio, next, &list, lru) {
 		bool bypass = false;
@@ -5611,13 +5618,6 @@
 
 		cond_resched();
 	}
-
-	/*
-	 * If too many file cache in the coldest generation can't be evicted
-	 * due to being dirty, wake up the flusher.
-	 */
-	if (sc->nr.unqueued_dirty && sc->nr.unqueued_dirty == sc->nr.file_taken)
-		wakeup_flusher_threads(WB_REASON_VMSCAN);
 
 	/* whether this lruvec should be rotated */
 	return nr_to_scan < 0;
