 		/*
 		 * The delay between the wakeup and the first instruction
@@ -248,14 +271,16 @@ static void teo_update(struct cpuidle_driver *drv, struct cpuidle_device *dev)
 		 * time, so take 1/2 of the exit latency as a very rough
