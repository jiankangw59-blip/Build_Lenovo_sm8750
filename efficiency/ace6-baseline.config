# Applied after all upstream and third-party configuration steps.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_HZ_250=y
# CONFIG_HZ_1000 is not set
CONFIG_NR_CPUS=32
CONFIG_PREEMPT=y
# The OPD2413 source archive and live kernel do not have the Ace 6 SCX option.
# CONFIG_SCHED_CLUSTER is not set
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_TASKS_TRACE_RCU=y
CONFIG_NO_HZ_IDLE=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CMDLINE_EXTEND=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_ZRAM_DEF_COMP_LZ4KD=y
CONFIG_ZRAM_DEF_COMP="lz4kd"
# CONFIG_UKSM is not set
# CONFIG_IOSCHED_BFQ is not set
# CONFIG_BFQ_GROUP_IOSCHED is not set
CONFIG_BLK_ICQ=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_PCPU_KTHREAD=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEFAULT_NET_SCH="fq_codel"
CONFIG_REKERNEL=y
