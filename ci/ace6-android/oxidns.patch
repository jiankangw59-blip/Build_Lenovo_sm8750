+#[tokio::test]
+async fn test_query_recorder_flushes_partial_batches_after_idle() {
+    AppClock::start();
+
+    let temp = NamedTempFile::new().unwrap();
+    let config =
+        resolve_config(Some(recorder_space_config(&temp.path().to_string_lossy()))).unwrap();
+    let mut plugin = QueryRecorder::new("rec".to_string(), config);
+    plugin.init_for_test().await.unwrap();
+    let backend = plugin.backend.as_ref().unwrap();
+    let mut records = backend.broadcaster.subscribe();
+
+    for request_id in 1..=2 {
+        backend.enqueue(pending_record(
+            i64::from(request_id),
+            request_id,
+            "partial-batch.example.com.",
+            RecordType::A,
+            Ipv4Addr::LOCALHOST,
+            Some(Rcode::NoError),
+            None,
+            &[],
+        ));
+        let record = tokio::time::timeout(Duration::from_secs(2), records.recv())
+            .await
