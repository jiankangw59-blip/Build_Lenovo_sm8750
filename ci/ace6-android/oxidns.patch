+#[tokio::test]
+async fn test_query_recorder_reaps_only_expired_records_when_its_deadline_is_due() {
+    use std::collections::VecDeque;
+    use std::sync::{Arc, Mutex, mpsc};
+
+    use super::backend::{DatabaseCoordinator, WriterThreadContext};
+    use super::store::run_writer_thread;
+
+    let temp = NamedTempFile::new().unwrap();
+    let path = temp.path().to_owned();
+    let tables = table_names("retention");
+    let mut conn = open_writer_database(&path).unwrap();
+    create_schema(&mut conn, &tables).unwrap();
+    let reader = open_reader_database(&path).unwrap();
+    let (queue, receiver) = mpsc::sync_channel(8);
+    let (broadcaster, mut updates) = tokio::sync::broadcast::channel(4);
+    let context = WriterThreadContext {
+        tag: "retention".to_string(),
+        path,
+        tables: tables.clone(),
+        tail: Arc::new(Mutex::new(VecDeque::new())),
+        memory_tail: 8,
+        broadcaster,
+        batch_size: 1,
+        flush_interval: Duration::from_millis(10),
+        retention_ms: 3_600_000,
+        cleanup_interval_ms: 10,
+        database_coordinator: Arc::new(DatabaseCoordinator::default()),
+    };
+    let writer = std::thread::spawn(move || run_writer_thread(context, receiver, conn));
+    let now_ms = jiff::Timestamp::now().as_millisecond();
+    for (request_id, created_at_ms) in [(1, now_ms - 7_200_000), (2, now_ms)] {
+        let record = pending_record(
+            created_at_ms,
+            request_id,
+            "retention.example.com.",
+            RecordType::A,
+            Ipv4Addr::LOCALHOST,
+            Some(Rcode::NoError),
+            None,
+            &[],
+        );
+        queue.send(WriterCommand::Insert(Box::new(record))).unwrap();
+        let update = tokio::time::timeout(Duration::from_secs(2), updates.recv())
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(update.record.request_id, request_id);
+    }
+
+    let sql = format!("SELECT COUNT(*), MAX(request_id) FROM {}", tables.records);
+    tokio::time::timeout(Duration::from_secs(2), async {
