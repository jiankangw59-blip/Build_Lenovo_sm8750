+            let stored: (i64, Option<i64>) = reader
+                .query_row(&sql, [], |row| Ok((row.get(0)?, row.get(1)?)))
+                .unwrap();
+            if stored == (1, Some(2)) {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(5)).await;
+        }
+    })
+    .await
+    .expect("the oldest record should expire while the writer is idle");
+    drop(queue);
+    writer.join().unwrap().unwrap();
+}
