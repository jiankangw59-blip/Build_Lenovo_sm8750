index 0000000000000000000000000000000000000000..bd375777eeb7c14e7b7b031804a28d00ca3357a0
--- /dev/null
+++ b/src/infra/deadline_alarm.rs
@@ -0,0 +1,63 @@
+// SPDX-FileCopyrightText: 2026 OxiDNS contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use tokio::sync::Notify;
+
+use crate::infra::clock::AppClock;
+
+pub(crate) const NO_DEADLINE: u64 = u64::MAX;
+
+/// A single consumer waits for the earliest deadline posted by producers.
+#[derive(Debug)]
+pub(crate) struct DeadlineAlarm {
+    deadline_ms: AtomicU64,
+    changed: Notify,
+}
+
+impl DeadlineAlarm {
+    pub(crate) fn new() -> Self {
+        Self {
+            deadline_ms: AtomicU64::new(NO_DEADLINE),
+            changed: Notify::new(),
+        }
+    }
+
+    pub(crate) fn schedule(&self, deadline_ms: u64) {
+        if self.deadline_ms.fetch_min(deadline_ms, Ordering::AcqRel) > deadline_ms {
+            self.changed.notify_one();
+        }
+    }
+
+    pub(crate) async fn wait(&self) {
+        loop {
+            let deadline_ms = self.deadline_ms.load(Ordering::Acquire);
+            if deadline_ms == NO_DEADLINE {
+                self.changed.notified().await;
+                continue;
+            }
+
+            let remaining = deadline_ms.saturating_sub(AppClock::elapsed_millis());
+            tokio::select! {
+                biased;
+                _ = self.changed.notified() => continue,
+                _ = tokio::time::sleep(Duration::from_millis(remaining)) => {}
+            }
+            // A producer may have advanced the deadline as the timer fired.
+            if self
+                .deadline_ms
+                .compare_exchange(
+                    deadline_ms,
+                    NO_DEADLINE,
+                    Ordering::AcqRel,
+                    Ordering::Acquire,
+                )
+                .is_ok()
+            {
+                return;
+            }
+        }
+    }
+}
diff --git a/src/plugin/matcher/adguard_dns.rs b/src/plugin/matcher/adguard_dns.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f67dc90236ed0ae625eee26402c5f1550e167fa3
--- /dev/null
+++ b/src/plugin/matcher/adguard_dns.rs
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! DNS filtering using separate AdGuard Home-style allow and block lists.
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use serde::Deserialize;
+
+use crate::config::types::PluginConfig;
+use crate::core::context::DnsContext;
+use crate::infra::error::{DnsError, Result as DnsResult};
+use crate::plugin::dependency::DependencySpec;
+use crate::plugin::matcher::Matcher;
+use crate::plugin::provider::Provider;
+use crate::plugin::provider::adguard_rule::{AdGuardRule, RuleAction};
+use crate::plugin::{Plugin, PluginFactory, PluginInitContext, UninitializedPlugin};
+use crate::plugin_factory;
+use crate::proto::rdata::SvcParamValue;
+use crate::proto::{Name, RData, RecordType};
+
+#[derive(Clone, Copy, Debug, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Stage {
+    QueryAllowed,
+    QueryBlocked,
+    ResponseBlocked,
+}
+
+#[derive(Debug, Deserialize)]
+struct Config {
+    stage: Stage,
+    rules: String,
+    allowlist: String,
+}
+
+impl Config {
+    fn parse(plugin: &PluginConfig) -> DnsResult<Self> {
+        let args = plugin
+            .args
+            .clone()
+            .ok_or_else(|| DnsError::plugin("adguard_dns requires args"))?;
+        serde_yaml_ng::from_value(args)
+            .map_err(|err| DnsError::plugin(format!("invalid adguard_dns args: {err}")))
+    }
+}
+
+#[derive(Debug, Clone)]
+#[plugin_factory("adguard_dns")]
+pub struct AdGuardDnsFactory;
+
+impl PluginFactory for AdGuardDnsFactory {
+    fn get_dependency_specs(&self, plugin: &PluginConfig) -> Vec<DependencySpec> {
+        Config::parse(plugin).map_or_else(
+            |_| Vec::new(),
+            |config| {
+                vec![
+                    DependencySpec::provider_type("args.rules", config.rules, "adguard_rule"),
+                    DependencySpec::provider_type(
+                        "args.allowlist",
+                        config.allowlist,
+                        "adguard_rule",
+                    ),
+                ]
+            },
+        )
+    }
+
+    fn create(
+        &self,
+        plugin: &PluginConfig,
+        _context: &PluginInitContext<'_>,
+    ) -> DnsResult<UninitializedPlugin> {
+        let config = Config::parse(plugin)?;
+        Ok(UninitializedPlugin::Matcher(Box::new(AdGuardDns {
+            tag: plugin.tag.clone(),
+            config,
+            providers: None,
+        })))
+    }
+}
+
+#[derive(Debug)]
+struct AdGuardDns {
+    tag: String,
+    config: Config,
+    providers: Option<(Arc<dyn Provider>, Arc<dyn Provider>)>,
+}
+
+#[async_trait]
+impl Plugin for AdGuardDns {
+    fn tag(&self) -> &str {
+        &self.tag
+    }
+
+    async fn init(&mut self, context: &PluginInitContext<'_>) -> DnsResult<()> {
+        let rules = context.provider_of_type("args.rules", &self.config.rules, "adguard_rule")?;
+        let allowlist =
+            context.provider_of_type("args.allowlist", &self.config.allowlist, "adguard_rule")?;
+        self.providers = Some((rules, allowlist));
+        Ok(())
+    }
+
+    async fn destroy(&self) -> DnsResult<()> {
+        Ok(())
+    }
+}
+
+impl Matcher for AdGuardDns {
+    fn is_match(&self, context: &mut DnsContext) -> bool {
+        let Some((rules, allowlist)) = &self.providers else {
+            return false;
+        };
+        let rules = rules
+            .as_any()
+            .downcast_ref::<AdGuardRule>()
+            .expect("validated AdGuard provider");
+        let allowlist = allowlist
+            .as_any()
+            .downcast_ref::<AdGuardRule>()
+            .expect("validated AdGuard provider");
+        let action = |name: &Name, qtype| {
+            if allowlist.action(name, qtype).is_some() {
+                Some(RuleAction::Allow)
+            } else {
+                rules.action(name, qtype)
+            }
+        };
+        let query_action = || {
+            context
+                .request()
+                .questions()
+                .first()
+                .and_then(|question| action(question.name(), question.qtype()))
+        };
+        match self.config.stage {
+            Stage::QueryAllowed => query_action() == Some(RuleAction::Allow),
+            Stage::QueryBlocked => query_action() == Some(RuleAction::Block),
+            Stage::ResponseBlocked => {
+                let blocked = |name: &Name, qtype| action(name, qtype) == Some(RuleAction::Block);
+                let blocked_ip = |ip: std::net::IpAddr, qtype| {
+                    Name::from_ascii(&ip.to_string()).is_ok_and(|name| blocked(&name, qtype))
+                };
+                context.response().is_some_and(|response| {
+                    response.answers().iter().any(|answer| match answer.data() {
+                        RData::CNAME(alias) => blocked(&alias.0, RecordType::CNAME),
+                        RData::A(ip) => blocked_ip(ip.0.into(), RecordType::A),
+                        RData::AAAA(ip) => blocked_ip(ip.0.into(), RecordType::AAAA),
+                        RData::HTTPS(https) => {
+                            https.0.params().iter().any(|param| match param.parsed() {
+                                SvcParamValue::Ipv4Hint(ips) => ips
+                                    .iter()
+                                    .any(|ip| blocked_ip((*ip).into(), RecordType::HTTPS)),
+                                SvcParamValue::Ipv6Hint(ips) => ips
+                                    .iter()
+                                    .any(|ip| blocked_ip((*ip).into(), RecordType::HTTPS)),
+                                _ => false,
+                            })
+                        }
+                        _ => false,
+                    })
+                })
+            }
+        }
+    }
+}
