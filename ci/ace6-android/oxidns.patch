+fn spawn_cache_cleanup(
+    cache: TtlCache<IpAddr, Arc<CacheEntry>>,
+    size: usize,
+) -> AbortOnDropHandle<()> {
+    AbortOnDropHandle::new(tokio::spawn(async move {
+        if cache.len() > size {
+            cache.schedule_cleanup_at(AppClock::elapsed_millis());
+        }
+        cache.schedule_next_expiry();
+        loop {
+            cache.wait_for_expiry().await;
+            let now = AppClock::elapsed_millis();
+            while cache.remove_expired_batch(now, EVICTION_BATCH) > 0 {
+                tokio::task::yield_now().await;
+            }
+
+            let overflow = cache.len().saturating_sub(size);
+            if overflow > 0 {
+                let count = overflow.min(EVICTION_BATCH);
+                let mut keys = cache.sample_last_access(count);
+                keys.sort_unstable_by_key(|(_, last_access_ms)| *last_access_ms);
+                for (key, _) in keys.into_iter().take(count) {
+                    cache.remove(&key);
+                }
+                if overflow > count {
+                    cache.schedule_cleanup_at(now.saturating_add(OVERFLOW_DELAY_MS));
+                }
+            }
+            cache.schedule_next_expiry();
+        }
+    }))
