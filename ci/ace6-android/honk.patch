 use super::*;
 use honk_config::routing::{RoutingCondition, RoutingOutbound};
 
+#[test]
+fn android_package_uses_the_owner_carried_by_handoff() {
+    let config = honk_config::parser::parse_dae_config(
+        "routing {\n android_package(com.example.long.reader) -> proxy\n fallback: direct\n}",
+    )
+    .unwrap();
+    let mut router = Router::from_config(&config.routing).unwrap();
+    let compiled = &mut Arc::make_mut(&mut router.routes.routes)[0].conditions[0];
+    compiled.predicate = CompiledPredicate::AndroidPackage(vec![10123]);
+    let conn = ConnectionInfo {
+        domain: Some("example.test".into()),
+        src_ip: "192.0.2.1".parse().unwrap(),
+        src_port: 30000,
+        dst_ip: "192.0.2.2".parse().unwrap(),
+        dst_port: 443,
+        protocol: "tcp",
+        process_name: Some("com.example.lon".into()),
+        mac: None,
+        dscp: None,
+    };
+    let owner = honk_ebpf_common::RoutingResult {
+        android_app_id: [0x8c, 0x27, 0], // 10123 + 1
+        ..Default::default()
+    };
+    let hit = router
+        .route_full_with_android_app_id(&conn, owner.android_app_id())
+        .unwrap();
+    assert_eq!(hit.action.outbound, "proxy");
+    assert!(
+        router
+            .route_full_with_android_app_id(&conn, Some(10124))
+            .is_none()
+    );
+    assert!(router.route_full_with_android_app_id(&conn, None).is_none());
+}
