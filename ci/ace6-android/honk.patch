new file mode 100644
index 0000000000000000000000000000000000000000..e4b9a418c4fd57e46db9d155f921d67dbee9988f
--- /dev/null
+++ b/src/crates/honk-core/src/routing/android_packages.rs
@@ -0,0 +1,122 @@
+//! Resolve immutable package ownership for one routing generation.
+
+use std::{collections::HashMap, io, path::Path};
+
+use anyhow::Context;
+use honk_ebpf_common::routing_policy::ANDROID_UID_RANGE;
+
+const PACKAGES_LIST: &str = "/data/system/packages.list";
+
+#[derive(Default)]
+pub(super) struct AndroidPackages {
+    by_name: HashMap<String, Option<u32>>,
+}
+
+impl AndroidPackages {
+    pub(super) fn load() -> anyhow::Result<Self> {
+        match std::fs::read_to_string(PACKAGES_LIST) {
+            Ok(data) => Self::parse(&data),
+            // A desktop can validate the configuration without Android's package table.
+            Err(error)
+                if error.kind() == io::ErrorKind::NotFound
+                    && !Path::new("/system/bin/getprop").exists() =>
+            {
+                Ok(Self::default())
+            }
+            Err(error) => Err(error).context("read Android package ownership"),
+        }
+    }
+
+    fn parse(data: &str) -> anyhow::Result<Self> {
+        let mut owners = HashMap::new();
+        let mut rows = Vec::new();
+        for (idx, line) in data.lines().enumerate() {
+            if line.is_empty() {
+                continue;
+            }
+            let mut fields = line.split_ascii_whitespace();
+            let (Some(name), Some(uid)) = (fields.next(), fields.next()) else {
+                anyhow::bail!("Android package ownership row {} is incomplete", idx + 1);
+            };
+            let uid = uid.parse::<u32>().with_context(|| {
+                format!(
+                    "invalid app ID in Android package ownership row {}",
+                    idx + 1
+                )
+            })?;
+            anyhow::ensure!(
+                uid < ANDROID_UID_RANGE,
+                "Android package ownership contains a non-base UID"
+            );
+            *owners.entry(uid).or_insert(0usize) += 1;
+            rows.push((name, uid));
+        }
+        let mut by_name = HashMap::new();
+        for (name, uid) in rows {
+            let owner = (owners[&uid] == 1).then_some(uid);
+            by_name
+                .entry(name.to_ascii_lowercase())
+                .and_modify(|entry| *entry = None)
+                .or_insert(owner);
+        }
+        Ok(Self { by_name })
+    }
+
+    pub(super) fn resolve(&self, names: &[String]) -> anyhow::Result<Vec<u32>> {
+        let mut app_ids = Vec::new();
+        for name in names {
+            anyhow::ensure!(
+                !name.is_empty()
+                    && name
+                        .bytes()
+                        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'_' | b'.')),
+                "android_package() requires literal Android package identifiers"
+            );
+            if let Some(owner) = self.by_name.get(&name.to_ascii_lowercase()) {
+                let Some(id) = owner else {
+                    anyhow::bail!("android_package() requires an unambiguous package owner");
+                };
+                app_ids.push(*id);
+            }
+        }
+        app_ids.sort_unstable();
+        app_ids.dedup();
+        Ok(app_ids)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn exact_packages_resolve_without_prefix_or_shared_uid_matches() {
+        let list = "com.example.long.alpha 10123 0\n\
+                    com.example.long.alphabet 10124 0\n\
+                    com.example.shared.first 10125 0\n\
+                    com.example.shared.second 10125 0\n";
+        let names = |s: &str| [s.to_owned()];
+        let packages = AndroidPackages::parse(list).unwrap();
+        assert_eq!(
+            packages.resolve(&names("COM.EXAMPLE.LONG.ALPHA")).unwrap(),
+            [10123]
+        );
+        assert_eq!(
+            packages
+                .resolve(&names("com.example.long.alphabet"))
+                .unwrap(),
+            [10124]
+        );
+        assert!(
+            packages
+                .resolve(&names("com.example.long"))
+                .unwrap()
+                .is_empty()
+        );
+        assert!(
+            packages
+                .resolve(&names("com.example.shared.first"))
+                .is_err()
+        );
